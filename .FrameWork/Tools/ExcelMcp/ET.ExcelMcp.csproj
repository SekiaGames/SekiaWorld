<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseUTF8Encoding>true</UseUTF8Encoding>
    <Version>1.0.0</Version>
    <RootNamespace>ET</RootNamespace>
    <LangVersion>12</LangVersion>
    <Configurations>Release</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <!-- 禁止从 .sln 编译，只能单独编本 csproj -->
  <Target Name="RejectSolutionBuild" BeforeTargets="Build"
          Condition="'$(BuildingSolutionFile)' == 'true'">
    <Error Text="禁止从 .sln 编译 ET.ExcelMcp：请直接编译本工程的 .csproj。" />
  </Target>

</Project>
